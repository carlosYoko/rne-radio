{
  "name": "rne-radio-extension",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "test:browser": "npm run build && node tools/smoke-browser.mjs",
    "icons": "npm run build && node tools/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "typescript": "^5.9.0"
  }
}
